rules_version = '2';
// 샘플 학급 규칙: 로그인(익명 포함)한 사람만 읽고 쓴다.
// 실제 운영 전: 학생은 자기 문서만, 교사는 반 전체를 쓰도록 좁혀야 한다 (docs/ROADMAP.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /students/{sid} {
        allow read, write: if request.auth != null;
      }
      match /hearts/{sid} {
        allow read: if request.auth != null;
        // 하트는 1씩만 올릴 수 있다
        allow create: if request.auth != null && request.resource.data.count == 1;
        allow update: if request.auth != null && request.resource.data.count == resource.data.count + 1;
      }
    }
  }
}
